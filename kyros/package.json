{
  "name": "kyros",
  "private": true,
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "proto:install-go-plugin": "go install google.golang.org/protobuf/cmd/protoc-gen-go@latest && go install google.golang.org/grpc/cmd/protoc-gen-go-grpc@latest",
    "proto:generate": "protoc --proto_path=proto --go_out=gen/go --go_opt=paths=source_relative --go-grpc_out=gen/go --go-grpc_opt=paths=source_relative proto/**/*.proto && npx ts-proto --protoPath=proto --outDir=gen/ts --target=ts --outputServices=grpc-js --outputJsonMethods=false proto/**/*.proto",
    "swagger:init": "go install github.com/swaggo/swag/cmd/swag@latest",
    "swagger:generate": "swag init -g ./cmd/api/main.go -o ./docs/swagger"
  },
  "devDependencies": {
    "turbo": "^2.x",
    "@types/node": "^22.x",
    "typescript": "^5.x",
    "ts-proto": "^2.0.0"
  },
  "engines": {
    "node": ">=20.0.0",
    "bun": ">=1.0.0"
  }
}
