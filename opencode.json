{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "MCP_DOCKER": {
      "type": "local",
      "command": ["docker", "mcp", "gateway", "run", "--profile", "dev_ops"],
      "enabled": true
    },
    "GitKraken": {
      "type": "local",
      "command": [
        "/Users/iemafzal/Library/Application Support/Code/User/globalStorage/eamodio.gitlens/gk",
        "mcp",
        "--host=opencode",
        "--source=gitlens",
        "--scheme=vscode"
      ],
      "enabled": true
    }
  },
